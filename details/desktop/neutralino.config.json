{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "io.pixelrush.game",
  "version": "0.5.0",
  "defaultMode": "window",
  "documentRoot": "/resources/",
  "url": "/index.html",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "none",
  "injectGlobals": true,
  "injectClientLibrary": true,
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.exit",
    "os.showSaveDialog",
    "os.showOpenDialog",
    "filesystem.writeFile",
    "filesystem.readFile",
    "window.setFullScreen",
    "window.exitFullScreen",
    "window.isFullScreen"
  ],
  "modes": {
    "window": {
      "title": "Pixel Rush",
      "width": 1280,
      "height": 760,
      "minWidth": 800,
      "minHeight": 480,
      "center": true,
      "fullScreen": false,
      "resizable": true,
      "maximize": false,
      "hidden": false,
      "enableInspector": false,
      "exitProcessOnClose": true,
      "icon": "/resources/icon.png"
    }
  },
  "cli": {
    "binaryName": "Pixel_Rush",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.5.0",
    "clientVersion": "6.5.0"
  },
  "port": 47923
}